#!/bin/bash
# wp-sync - WordPress環境同期ツール
#
# 使用方法:
#   wp-sync init <domain>         サイト設定を初期化
#   wp-sync prd-to-stg <domain>   本番 → ステージング同期
#   wp-sync stg-to-prd <domain>   ステージング → 本番同期

set -euo pipefail

WP_SYNC_DIR="$(cd "$(dirname "$0")/.." && pwd)"
export WP_SYNC_DIR

# shellcheck source=/dev/null
. "$WP_SYNC_DIR/lib/log.sh"
# shellcheck source=/dev/null
. "$WP_SYNC_DIR/lib/env.sh"
# shellcheck source=/dev/null
. "$WP_SYNC_DIR/lib/restore.sh"

action="${1:-}"
domain="${2:-}"

# ドメイン引数の必須チェック（help以外）
case "$action" in
  -h|--help|help) ;;
  *)
    if [ -z "$domain" ]; then
      echo "エラー: ドメインを指定してください。" >&2
      echo "使用方法: wp-sync {init|prd-to-stg|stg-to-prd} <domain>" >&2
      exit 1
    fi
    SITE_DIR="$WP_SYNC_DIR/sites/$domain"
    export SITE_DIR
    ;;
esac

# 終了時の処理（エラー時はロールバック）
cleanup() {
  local exit_code=$?

  if [ "$exit_code" -ne 0 ]; then
    perform_rollback
  fi

  finalize_log
  exit "$exit_code"
}
trap cleanup EXIT

case "$action" in
  init)
    if [ -d "$SITE_DIR" ]; then
      echo "エラー: $SITE_DIR は既に存在します。" >&2
      exit 1
    fi
    mkdir -p "$WP_SYNC_DIR/sites"
    cp -r "$WP_SYNC_DIR/template" "$SITE_DIR"
    mv "$SITE_DIR/.env.example" "$SITE_DIR/.env"
    echo "サイト設定を作成しました: $SITE_DIR"
    echo "$SITE_DIR/.env を編集して接続情報を設定してください。"
    ;;
  prd-to-stg|stg-to-prd)
    if [ ! -d "$SITE_DIR" ]; then
      echo "エラー: $SITE_DIR が見つかりません。" >&2
      echo "先に wp-sync init $domain を実行してください。" >&2
      exit 1
    fi
    if [ "$action" = "prd-to-stg" ]; then
      sync_label="本番 → ステージング同期"
    else
      sync_label="ステージング → 本番同期"
    fi
    init_log "$action"
    set_restore_direction "$action"
    log_info "${sync_label}を開始します..."
    log_info "ログファイル: $(get_log_file)"
    echo ""
    # shellcheck source=/dev/null
    . "$WP_SYNC_DIR/scripts/run-sync.sh" "$action"
    log_success "${sync_label}が完了しました"
    ;;
  -h|--help|help)
    echo "wp-sync - WordPress環境同期ツール"
    echo ""
    echo "使用方法:"
    echo "  wp-sync init <domain>         サイト設定を初期化"
    echo "  wp-sync prd-to-stg <domain>   本番 → ステージング同期"
    echo "  wp-sync stg-to-prd <domain>   ステージング → 本番同期"
    echo "  wp-sync help                  このヘルプを表示"
    echo ""
    echo "例:"
    echo "  wp-sync init example.com"
    echo "  wp-sync prd-to-stg example.com"
    echo ""
    echo "ログファイル:"
    echo "  sites/<domain>/logs/ に保存されます（${LOG_RETENTION_DAYS}日間保持）"
    ;;
  *)
    echo "使用方法: wp-sync {init|prd-to-stg|stg-to-prd|help} <domain>" >&2
    exit 1
    ;;
esac
